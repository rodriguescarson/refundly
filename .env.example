# Refundly — local development. Copy to .env and fill in.
#
# 1) AI via OpenRouter — one key, any model (controller, workers, auditor, vision).
#    Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# 2) PayPal sandbox — the agent's refund/cancellation actions AND the verifier's
#    independent ledger read-back both go through PayPal.
#    Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_SECRET=your-sandbox-secret
PAYPAL_ENV=sandbox

# Local store, no cloud.
ATTEST_STORE=memory

# --- optional -----------------------------------------------------------------
# Override any model (defaults are OpenRouter ids):
# ATTEST_CONTROLLER_MODEL=openrouter/google/gemini-2.5-flash
# ATTEST_AUDITOR_MODEL=openrouter/anthropic/claude-3.5-haiku
#
# GCP-only extras stay OFF unless GOOGLE_CLOUD_PROJECT is set: Model Armor guardrail,
# Agent Registry, Vertex tracing. The spoken briefing (TTS) has no OpenRouter equivalent.
# GOOGLE_CLOUD_PROJECT=
ATTEST_FAULT_RATE=0
